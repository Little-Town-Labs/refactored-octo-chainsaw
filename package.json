{
  "name": "spyglass",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Project Spyglass — two-sided AI hiring platform for the agentic era",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=9.0.0 <10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@5": "5.0.6",
      "js-cookie": "3.0.7",
      "ws@8.20.0": "8.21.0",
      "@babel/core": "7.29.6",
      "@opentelemetry/core": "2.8.0",
      "esbuild": "0.28.1",
      "js-yaml@3": "3.15.0",
      "protobufjs": "7.6.3"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "lint": "turbo run lint",
    "schema:lint": "bash scripts/check-schema-conventions.sh",
    "schema:lint:test": "bash scripts/__tests__/check-schema-conventions.test.sh",
    "tickets:coverage": "bash scripts/check-tickets-state-machine.sh",
    "product:gate": "PRODUCT_HARNESS_COMMAND=product:gate pnpm --silent --filter @spyglass/product-test-harness run:reporting-ci",
    "product:eval": "PRODUCT_HARNESS_COMMAND=product:eval pnpm --silent --filter @spyglass/product-test-harness run:reporting-ci",
    "product:canary": "PRODUCT_HARNESS_COMMAND=product:canary pnpm --silent --filter @spyglass/product-test-harness run:reporting-ci",
    "type-check": "turbo run type-check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "gen:env-example": "tsx scripts/gen-env-example.ts",
    "changeset": "changeset",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.41",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "eslint": "^10.6.0",
    "eslint-config-next": "^16.2.10",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^7.0.0",
    "eslint-plugin-import": "^2.32.0",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "lefthook": "^2.1.9",
    "prettier": "3.9.5",
    "tsx": "^4.22.4",
    "turbo": "^2.9.18",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.61.0"
  }
}
