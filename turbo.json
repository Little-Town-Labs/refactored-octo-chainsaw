{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["tsconfig.base.json", ".env.example"],
  "globalEnv": [
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SIGNING_SECRET",
    "DATABASE_URL",
    "INNGEST_EVENT_KEY",
    "INNGEST_SIGNING_KEY",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "OPENROUTER_API_KEY",
    "OPENROUTER_APP_TITLE",
    "OPENROUTER_APP_URL",
    "OPENROUTER_BASE_URL",
    "SPYGLASS_AGENT_JWT_ISSUER",
    "SPYGLASS_AGENT_SIGNING_KEY_PKCS8_B64",
    "SPYGLASS_AGENT_SIGNING_KID",
    "SPYGLASS_OPERATOR_CLERK_ORG_IDS"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": ["*.tsbuildinfo", "dist/**/*.d.ts"]
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["SPYGLASS_SKIP_PERF_BENCHMARKS"],
      "outputs": ["coverage/**"]
    },
    "test:integration": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": ["NEON_API_KEY", "NEON_PROJECT_ID", "NEON_PARENT_BRANCH_ID", "DATABASE_URL"],
      "outputs": []
    },
    "format:check": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
